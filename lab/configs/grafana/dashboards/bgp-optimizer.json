              "options": {
                "-1": {
                  "text": "optimizer down",
                  "color": "red",
                  "index": 0
                },
                "0": {
                  "text": "steady: current path is fine",
                  "color": "green",
                  "index": 1
                },
                "1": {
                  "text": "confirming: better path seen, checking again",
                  "color": "yellow",
                  "index": 2
                },
                "2": {
                  "text": "hold-down: waiting before the next change",
                  "color": "orange",
                  "index": 3
                },
                "3": {
                  "text": "rate limited",
                  "color": "red",
                  "index": 4
                },
                "4": {
                  "text": "collecting data",
                  "color": "#808080",
                  "index": 5
                },
                "5": {
                  "text": "all providers bad: not touching anything",
                  "color": "dark-red",
                  "index": 6
                },
                "6": {
                  "text": "switching now",
                  "color": "purple",
                  "index": 7
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
